generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripStatus {
  PLANNING
  BOOKED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  TRANSPORT
  LODGING
  FOOD
  ACTIVITIES
  SHOPPING
  OTHER
}

enum HiddenGemType {
  ATTRACTION
  CAFE
  VIEWPOINT
  HIKE
  BEACH
  MUSEUM
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  bio          String?
  avatarUrl    String?
  homeCity     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips        Trip[]
  gems         HiddenGem[] @relation("GemAuthor")
  gemReviews   HiddenGemReview[]
  journal      JournalEntry[]
  alerts       Alert[]

  chatMemberships ChatMember[]
  messages        ChatMessage[]
}

model Trip {
  id          String     @id @default(cuid())
  userId      String
  title       String
  destination String
  startDate   DateTime
  endDate     DateTime
  interests   String[]   @default([])
  budgetTotal Int?
  budgetCurrency String  @default("USD")
  status      TripStatus @default(PLANNING)

  // stored for maps + alerts
  latitude    Float?
  longitude   Float?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary   ItineraryDay[]
  expenses    Expense[]
  packingList PackingListItem[]
  journal     JournalEntry[]

  companionPosts CompanionPost[]

  @@index([userId])
  @@index([destination, startDate, endDate])
}

model ItineraryDay {
  id           String   @id @default(cuid())
  tripId       String
  dayNumber    Int
  title        String
  summary      String
  estDailyCost Int?
  places       ItineraryPlace[]
  hotels       ItineraryHotel[]
  createdAt    DateTime @default(now())

  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
}

model ItineraryPlace {
  id            String   @id @default(cuid())
  itineraryDayId String
  name          String
  kind          String   // museum, viewpoint, cafe...
  description   String?
  latitude      Float?
  longitude     Float?
  estCost       Int?
  order         Int      @default(0)

  day           ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId])
}

model ItineraryHotel {
  id            String   @id @default(cuid())
  itineraryDayId String
  name          String
  neighborhood  String?
  pricePerNight Int?
  latitude      Float?
  longitude     Float?

  day           ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)
}

model HiddenGem {
  id          String   @id @default(cuid())
  authorId    String
  city        String
  name        String
  type        HiddenGemType @default(OTHER)
  description String
  address     String?
  latitude    Float?
  longitude   Float?
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation("GemAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviews     HiddenGemReview[]

  @@index([city])
  @@index([authorId])
}

model HiddenGemReview {
  id        String   @id @default(cuid())
  gemId     String
  userId    String
  rating    Int      // 1..5
  comment   String?
  createdAt DateTime @default(now())

  gem       HiddenGem @relation(fields: [gemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gemId, userId])
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  date        DateTime
  amount      Int
  currency    String          @default("USD")
  category    ExpenseCategory @default(OTHER)
  note        String?
  createdAt   DateTime        @default(now())

  trip        Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
}

model CompanionPost {
  id          String   @id @default(cuid())
  tripId      String
  destination String
  startDate   DateTime
  endDate     DateTime
  message     String?
  createdAt   DateTime @default(now())

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([destination, startDate, endDate])
}

model ChatRoom {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  members   ChatMember[]
  messages  ChatMessage[]
}

model ChatMember {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  joinedAt  DateTime @default(now())

  chat      ChatRoom @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  chatId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  chat      ChatRoom @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
}

model PackingListItem {
  id        String   @id @default(cuid())
  tripId    String
  label     String
  quantity  Int      @default(1)
  checked   Boolean  @default(false)
  category  String   @default("General")

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  kind      String   // WEATHER | FLIGHT | SAFETY
  title     String
  body      String
  severity  String   @default("info") // info | warning | critical
  city      String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PhotoSpot {
  id        String   @id @default(cuid())
  city      String
  name      String
  description String?
  latitude  Float?
  longitude Float?
  sampleImageUrl String?
  tags      String[] @default([])
  createdAt DateTime @default(now())

  @@index([city])
}

model JournalEntry {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  date      DateTime
  title     String
  note      String
  photos    JournalPhoto[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId, date])
  @@index([userId, createdAt])
}

model JournalPhoto {
  id        String   @id @default(cuid())
  entryId   String
  url       String
  caption   String?

  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
}

